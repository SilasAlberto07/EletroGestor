{
  "name": "eletrogestor",
  "productName": "EletroGestor",
  "version": "1.0.16",
  "description": "Sistema de orçamentos para serviços elétricos",
  "main": "src/main/main.js",
  "author": "EletroGestor",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "publicar": "electron-builder --win --publish always",
    "lancar": "npm version patch && git push --follow-tags",
    "lancar:funcao": "npm version minor && git push --follow-tags",
    "lancar:grande": "npm version major && git push --follow-tags",
    "apk": "npm --prefix mobile install && npm --prefix mobile run apk",
    "celular:testar": "npm --prefix mobile install && npm --prefix mobile run testar"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
